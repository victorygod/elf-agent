{
  "uiType": "dm-game",
  "page": {
    "chatView": "DnDChatView"
  },
  "config": {
    "tabs": [
      {
        "key": "saves",
        "label": "存档管理",
        "component": "SaveManager"
      },
      {
        "key": "prompt",
        "label": "提示词配置",
        "fields": [
          { "key": "systemPrompt", "type": "textarea", "label": "总纲 system_prompt", "hint": "DM 人设总纲 + 正典规则 + 基础世界观" },
          { "key": "loop_outline_prompt", "type": "textarea", "label": "outline 大纲任务", "hint": "outline loop 任务：写大纲 + 自查维护" },
          { "key": "loop_render_prompt", "type": "textarea", "label": "render 渲染任务", "hint": "render loop 渲染指令" },
          { "key": "compactPrompt", "type": "textarea", "label": "历史压缩指令" },
          { "key": "compactSystemPrompt", "type": "textarea", "label": "压缩系统提示词（可空）" }
        ]
      },
      {
        "key": "agent",
        "label": "Agent 配置",
        "fields": [
          { "key": "avatar", "type": "avatar" },
          { "key": "name", "type": "text", "label": "Agent 名称", "hint": "前端显示名" },
          { "key": "tools", "type": "readonly-tags", "label": "已启用工具" },
          { "key": "memoryTokenLimit", "type": "number", "label": "记忆压缩 Token 上限" },
          { "key": "maxIterations", "type": "number", "label": "最大迭代轮数" }
        ]
      },
      {
        "key": "model",
        "label": "模型配置",
        "fields": [
          { "key": "base_url", "type": "text", "label": "API Base URL", "hint": "LLM API 端点" },
          { "key": "auth_token", "type": "text", "label": "Auth Token", "hint": "LLM API 认证密钥" },
          { "key": "model", "type": "text", "label": "模型名称", "hint": "如 deepseek-chat" }
        ]
      }
    ]
  }
}